PORT=4000
CONVEX_URL=http://127.0.0.1:3210
JWT_SECRET=dev_only_change_this_secret
API_PUBLIC_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
MAGIC_LINK_LOGIN_URL=http://localhost:5173/login
MAIL_PROVIDER=log
MAIL_FROM=Inkō <no-reply@localhost>
# Required when MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# fallback returns sentence-aligned study scaffolding without external calls.
# openai uses @ai-sdk/openai.
# openai_compatible and opencode_zen use @ai-sdk/openai-compatible.
# vercel_gateway uses the AI SDK Gateway provider.
TRANSLATION_PROVIDER=fallback
# TRANSLATION_MODEL=gpt-4o-mini

# OpenAI
# TRANSLATION_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# OpenAI-compatible backend. Base URL should be the API root, not /chat/completions.
# TRANSLATION_PROVIDER=openai_compatible
# TRANSLATION_BASE_URL=https://api.example.com/v1
# TRANSLATION_API_KEY=sk-xxxxxxxxxxxxx
# TRANSLATION_OPENAI_COMPATIBLE_NAME=my-provider
# TRANSLATION_SUPPORTS_STRUCTURED_OUTPUTS=true

# OpenCode Zen, when exposed through an OpenAI-compatible endpoint.
# TRANSLATION_PROVIDER=opencode_zen
# OPENCODE_ZEN_BASE_URL=http://127.0.0.1:1234/v1
# OPENCODE_ZEN_API_KEY=local-or-remote-key

# Vercel AI Gateway. Model ids usually include provider/name, e.g. openai/gpt-5.2.
# TRANSLATION_PROVIDER=vercel_gateway
# AI_GATEWAY_API_KEY=your_gateway_key
# TRANSLATION_MODEL=openai/gpt-5.2
